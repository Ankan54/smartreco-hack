# Copy to .env and fill in. .env is gitignored and must stay that way.
# Only MESH_API_KEY is required -- everything below it is optional and the app
# boots without it.

# --- required --------------------------------------------------------------
# Mesh API is mandatory for this hackathon: every LLM and embedding call in this
# repo goes through it. Get a key (starts with rsk_) from the Mesh dashboard.
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Model ids. On Mesh these carry a provider prefix; against OpenAI directly they
# do not. That is the ONLY difference between the two, which is why this repo has
# no provider branch anywhere -- see app/mesh.py.
LLM_MODEL_ID="openai/gpt-5-nano"
EMBEDDING_MODEL_ID="openai/text-embedding-3-small"
EMBED_DIM=1536

# The generate node writes the only prose a human reads, so it gets the better
# model. grade/critic/reflect stay on the cheap one.
GENERATE_MODEL="openai/gpt-5-mini"

# gpt-5-nano burns ~128 reasoning tokens on a trivial prompt; "low" halves it.
# Measured: "none" is rejected by this model.
REASONING_EFFORT=low

# Change SECRET_KEY for anything that is not local development.
SECRET_KEY=dev-only-not-a-secret-change-in-prod

# --- optional: observability (bonus) ---------------------------------------
# With a key set, every Mesh call is traced. Without one, tracing is simply off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reckon

# --- optional: scheduled email digest (bonus) ------------------------------
# Plain SMTP, so any provider works. Brevo has the best permanent free tier
# (300/day) and needs neither a domain nor an app password:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
# Gmail also works, but the account needs 2FA on and an App Password:
#   SMTP_HOST=smtp.gmail.com         SMTP_PORT=587
# Leave SMTP_HOST empty and delivery is disabled -- nothing else breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Reckon <you@example.com>

# Used to build absolute links inside the digest.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Digest send time, UTC. Sweep interval in minutes.
DIGEST_HOUR=16
DIGEST_MINUTE=0
SWEEP_MINUTES=15
ENABLE_SCHEDULER=1

# --- optional: paths -------------------------------------------------------
# DB_PATH=./data/app.db
# CHROMA_PATH=./data/chroma
